{
  "expo": {
    "name": "Chama",
    "slug": "chama",
    "scheme": "chama",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#D4562A",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chama.app"
    },
    "android": {
      "package": "com.chama.app",
      "adaptiveIcon": {
        "backgroundColor": "#D4562A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c35b7b2d-ad2a-4ce6-a05d-ca3a42f4bf8b"
      }
    },
    "owner": "diegoramos-dev"
  }
}
